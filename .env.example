# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA SAAS FACTURACIÓN ELECTRÓNICA (e-CF) RD
# ==============================================================================

NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Base de Datos PostgreSQL 16
DATABASE_URL="postgresql://ecf_user:ecf_secure_password@localhost:5432/factura_ecf_db?schema=public"

# Redis 7 (Caché de tokens GTI, BullMQ, Rate Limiting & Idempotencia)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Seguridad y Criptografía (AES-256-GCM - Clave de 32 bytes en formato Hex)
# Generar con: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_dominicana_ecf_change_me_in_prod
JWT_EXPIRATION=7d

# GTI Partner Configuration (GTI República Dominicana)
# NOTA: MedioEmision es asignado por GTI a nivel de Partner/Instalación
GTI_MEDIO_EMISION=xy1fcYHxWxjJ10t3ZD5Hlg==
GTI_SANDBOX_BASE_URL=https://pruebas.facturadominicana.do/apicargafactura
GTI_PRODUCTION_BASE_URL=https://facturadominicana.do/apicargafactura

# Rate Limiting (Peticiones por minuto por API Key)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60

# Configuración de Idempotencia (en segundos: 86400 = 24 horas)
IDEMPOTENCY_TTL_SECONDS=86400

# Almacenamiento Legal de XMLs (5+ Años de retención legal requerida por DGII)
STORAGE_DRIVER=local # 'local' | 's3' | 'r2'
STORAGE_LOCAL_PATH=./storage/xml
S3_BUCKET=factura-ecf-xml-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# URLs públicas
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Conectores Delivery (Uber Eats & PedidosYa)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ENV=sandbox # 'sandbox' | 'production'
PEDIDOSYA_WEBHOOK_SECRET=
